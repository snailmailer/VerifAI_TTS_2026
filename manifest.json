{
  "manifest_version": 3,
  "name": "VerifAI Approval Gate",
  "version": "0.5.5",
  "description": "Blocks catalogued unapproved AI sites and records approved visits and blocked attempts.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "tabs",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.claude.ai/*",
    "*://*.claude.com/*",
    "*://*.anthropic.com/*",
    "*://*.askaichat.app/*",
    "*://*.aichatapp.ai/*",
    "*://*.chatgpt.com/*",
    "*://*.chat.com/*",
    "*://*.openai.com/*",
    "*://*.lovable.dev/*",
    "*://*.lovable.app/*",
    "*://*.poe.com/*",
    "*://*.deepseek.com/*",
    "*://*.deepseek.ai/*",
    "*://*.grok.com/*",
    "*://*.x.ai/*",
    "*://*.meta.ai/*",
    "*://*.mistral.ai/*",
    "*://*.chat.mistral.ai/*",
    "*://*.you.com/*",
    "*://*.character.ai/*",
    "*://*.c.ai/*",
    "*://*.pi.ai/*",
    "*://*.inflection.ai/*",
    "*://*.huggingface.co/*",
    "*://*.huggingface.com/*",
    "*://*.hf.co/*",
    "*://*.hf.space/*",
    "*://*.iask.ai/*",
    "*://*.devin.ai/*",
    "*://*.gamma.app/*",
    "*://*.qwen.ai/*",
    "*://*.qwenlm.ai/*",
    "*://*.tongyi.com/*",
    "*://*.kimi.com/*",
    "*://*.kimi.ai/*",
    "*://*.moonshot.cn/*",
    "*://*.manus.im/*",
    "*://*.genspark.ai/*",
    "*://*.replit.com/*",
    "*://*.replit.ai/*",
    "*://*.bolt.new/*",
    "*://*.cursor.com/*",
    "*://*.cursor.sh/*",
    "*://*.windsurf.com/*",
    "*://*.codeium.com/*",
    "*://*.v0.dev/*",
    "*://*.v0.app/*",
    "*://*.phind.com/*",
    "*://*.blackbox.ai/*",
    "*://*.jasper.ai/*",
    "*://*.writesonic.com/*",
    "*://*.copy.ai/*",
    "*://*.rytr.me/*",
    "*://*.chatsonic.com/*",
    "*://*.askyourpdf.com/*",
    "*://*.chatpdf.com/*",
    "*://*.notebooklm.google.com/*",
    "*://*.aistudio.google.com/*",
    "*://*.sora.com/*",
    "*://*.midjourney.com/*",
    "*://*.runwayml.com/*",
    "*://*.leonardo.ai/*",
    "*://*.ideogram.ai/*",
    "*://*.suno.com/*",
    "*://*.udio.com/*",
    "*://*.elevenlabs.io/*",
    "*://*.copilot.microsoft.com/*",
    "*://*.copilot.com/*",
    "*://*.m365.cloud.microsoft/*",
    "*://*.gemini.google.com/*",
    "*://*.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open VerifAI dashboard"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.copilot.microsoft.com/*",
        "*://*.copilot.com/*",
        "*://*.m365.cloud.microsoft/*",
        "*://*.gemini.google.com/*",
        "*://*.perplexity.ai/*"
      ],
      "js": [
        "ai-policy.js",
        "redaction-core.js",
        "redaction.js",
        "activity.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ai_blocklist",
        "enabled": true,
        "path": "ai-block-rules.json"
      }
    ]
  },
  "options_page": "dashboard.html",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "128": "VerifAI Logo.png"
  },
  "incognito": "spanning"
}
